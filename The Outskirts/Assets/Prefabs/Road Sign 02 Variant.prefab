  m_text: "\n\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \"\u0421\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435
    \u0422\u0440\u044C\u043E\u0445\". \u0422\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F
    \u0442\u0438\u0445, \u0445\u0442\u043E \u0437\u043D\u0430\u0454 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0457
    \u043F\u0440\u0435\u0434\u043A\u0456\u0432. \u041D\u0435\u0443\u0432\u0430\u0436\u043D\u0438\u043C
    \u2014 \u0441\u043C\u0435\u0440\u0442\u044C.\n\n\u041F\u043E\u0437\u0430\u0434\u0443
    \u043E\u043A\u043E\u043B\u0438\u0446\u0456 \u041C\u043E\u0440\u043D\u0433\u043E\u043B\u0434\u0430.
    \u0411\u0435\u0437\u043F\u0435\u043A\u0430 \u0434\u043B\u044F \u0441\u043B\u0430\u0431\u043A\u0438\u0445
    \u0434\u0443\u0445\u043E\u043C."
