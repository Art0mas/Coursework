  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\"\u041B\u0438\u0441\u0442 \u0434\u043E \u0431\u0440\u0430\u0442\u0430\"</b>\n\u0417\u0435\u043C\u043B\u044F
    \u0446\u044C\u043E\u0433\u043E \u0440\u043E\u043A\u0443 \u0441\u0442\u0430\u043B\u0430
    \u0442\u0432\u0435\u0440\u0434\u043E\u044E \u0456 \u043C\u0435\u0440\u0437\u043B\u043E\u044E,
    \u043D\u0456\u0431\u0438 \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
    \u0440\u043E\u0434\u0438\u0442\u0438. \u0411\u0430\u0442\u044C\u043A\u043E \u043A\u0430\u0436\u0435,
    \u0449\u043E \u0446\u0435 \u0447\u0435\u0440\u0435\u0437 \u0442\u043E\u0439 \u0433\u043B\u0443\u0445\u0438\u0439
    \u0433\u0443\u043B, \u044F\u043A\u0438\u0439 \u043D\u043E\u0447\u0430\u043C\u0438
    \u0439\u0434\u0435 \u0437-\u043F\u0456\u0434 \u0421\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0430
    \u2014 \u0432\u0456\u043D \u0432\u0456\u0434\u043B\u044F\u043A\u0443\u0454 \u043D\u0430\u0432\u0456\u0442\u044C
    \u0447\u0435\u0440\u0432\u0456\u0432 \u0443 \u0491\u0440\u0443\u043D\u0442\u0456.
    \u0410\u043B\u0435 \u043C\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0454\u043C\u043E
    \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438. \u0425\u0442\u043E\u0441\u044C
    \u0436\u0435 \u043C\u0430\u0454 \u0441\u0456\u044F\u0442\u0438 \u0437\u0435\u0440\u043D\u043E.
    \u0417\u0430\u0432\u0442\u0440\u0430 \u043D\u0430\u0433\u043E\u0441\u0442\u0440\u044E
    \u0432\u0438\u043B\u0430, \u0442\u0440\u0435\u0431\u0430 \u0432\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0438
    \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0441\u0456\u043D\u043E \u0434\u043E
    \u0434\u043E\u0449\u0456\u0432. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
    \u0446\u0435\u0439 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u0441\u043A\u0440\u0435\u0433\u0456\u0442
    \u0437-\u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0456 \u0441\u043A\u043E\u0440\u043E
    \u043F\u0440\u0438\u043F\u0438\u043D\u0438\u0442\u044C\u0441\u044F..."
