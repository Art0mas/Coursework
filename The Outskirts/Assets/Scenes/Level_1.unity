      m_Calls: []
  m_text: "\u0421\u0432\u0456\u0442\u043B\u043E \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0456\u0445
    \u0440\u0443\u0457\u043D \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u043B\u043E
    \u0442\u0456\u043D\u044C \u0442\u0432\u043E\u0433\u043E \u043C\u0435\u0447\u0430.
    \u0422\u0438 \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0442\u0435, \u0449\u043E
    \u0448\u0443\u043A\u0430\u0432, \u0447\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u0442\u0430\u0432 \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E \u0446\u0456\u0454\u0457
    \u0442\u0438\u0448\u0456? \u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
    \u0437\u043D\u0430\u044E\u0442\u044C \u043B\u0438\u0448\u0435 \u0440\u0443\u0457\u043D\u0438...
    \u0456 \u0432\u043E\u043D\u0438 \u0432\u043C\u0456\u044E\u0442\u044C \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438
    \u0441\u0435\u043A\u0440\u0435\u0442\u0438.\n\u0426\u0435 \u043A\u0456\u043D\u0435\u0446\u044C...
    \u0410\u0431\u043E \u043B\u0438\u0448\u0435 \u043F\u043E\u0447\u0430\u0442\u043E\u043A?
    \u0421\u0438\u043D\u0456\u0439 \u0432\u043E\u0433\u043E\u043D\u044C \u0440\u0443\u0457\u043D
    \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043E\u0431\u043F\u0456\u043A\u0430\u0454
    \u0442\u0432\u043E\u0457 \u043E\u0447\u0456. \u0410\u043B\u0435 \u0432\u0456\u043D
    \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F
    \u0443 \u0442\u0432\u043E\u0454\u043C\u0443 \u0441\u0435\u0440\u0446\u0456. \u0422\u0438
    \u043F\u0435\u0440\u0435\u043C\u0456\u0433... \u0430\u043B\u0435 \u0447\u0438
    \u0432\u0438\u0433\u0440\u0430\u0432 \u0442\u0438 \u0432\u0456\u0439\u043D\u0443
    \u0437\u0430 \u0432\u043B\u0430\u0441\u043D\u0443 \u0434\u0443\u0448\u0443?"
