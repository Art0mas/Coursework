  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\"\u041E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u043D\u0430\u043A\u0430\u0437
    \u0410\u0440\u0445\u0456\u0442\u0435\u043A\u0442\u043E\u0440\u0430\"</b>\n\u0415\u0440\u0430
    \u041C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0456\u0432 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F
    \u043C\u043E\u0432\u0447\u0430\u043D\u043D\u044F\u043C. \u041C\u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0443\u0454\u043C\u043E
    \u0421\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435 \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438.
    \u0422\u0435, \u0449\u043E \u043C\u0438 \u0432\u0432\u0430\u0436\u0430\u043B\u0438
    \u0434\u0430\u0440\u043E\u043C \u043F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u044C,
    \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F\u043C,
    \u0449\u043E \u043E\u0442\u0440\u0443\u044E\u0454 \u0440\u043E\u0437\u0443\u043C.
    \u0411\u0440\u0430\u043C\u0438 \u0437\u0430\u0447\u0438\u043D\u0435\u043D\u043E.
    \u041F\u0430\u0441\u0442\u043A\u0438 \u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u0432 \u0431\u043E\u0439\u043E\u0432\u0438\u0439 \u0441\u0442\u0430\u043D. \u0413\u0440\u043E\u043C\u0430\u0434\u044F\u043D\u0430\u043C
    \u041E\u043A\u043E\u043B\u0438\u0446\u044C \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u043E
    \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438 \u043C\u0456\u0441\u0442\u043E.
    \u042F\u043A\u0449\u043E \u0432\u0438 \u0447\u0443\u0454\u0442\u0435 \u0432\u043D\u043E\u0447\u0456
    \u0433\u0443\u043B \u0448\u0435\u0441\u0442\u0435\u0440\u0435\u043D\u044C \u0437-\u043F\u0456\u0434
    \u0437\u0435\u043C\u043B\u0456 \u2014 \u0437\u043D\u0430\u0439\u0442\u0435: '\u0412\u0456\u0447\u043D\u0435
    \u0421\u0435\u0440\u0446\u0435' \u0432\u0441\u0435 \u0449\u0435 \u0431'\u0454\u0442\u044C\u0441\u044F,
    \u0456 \u0432\u043E\u043D\u043E \u043F\u0440\u0430\u0433\u043D\u0435 \u0432\u0438\u0431\u0440\u0430\u0442\u0438\u0441\u044F
    \u043D\u0430\u0437\u0443\u0441\u0442\u0440\u0456\u0447 \u0441\u043E\u043D\u0446\u044E."
