  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\"\u041D\u0435 \u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F \u0457\u043C
    \u0432 \u043E\u0447\u0456!\"</b>\n\u0422\u0456 \u0434\u0440\u0456\u0431\u043D\u0456
    \u043F\u043E\u0442\u0432\u043E\u0440\u043D\u0456 \u0441\u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F,
    \u0449\u043E \u043D\u0438\u0448\u043F\u043E\u0440\u044F\u0442\u044C \u0443 \u0442\u0435\u043C\u0440\u044F\u0432\u0456
    \u2014 \u043D\u0435 \u0434\u0438\u043A\u0456 \u0437\u0432\u0456\u0440\u0456.
    \u041F\u0440\u0438\u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F \u0434\u043E
    \u0457\u0445\u043D\u0456\u0445 \u0440\u0443\u043A. \u0412\u043E\u043D\u0438 \u0434\u043E\u0441\u0456
    \u043D\u043E\u0441\u044F\u0442\u044C \u0456\u0440\u0436\u0430\u0432\u0456 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438.
    \u0426\u0435 \u043D\u0430\u0449\u0430\u0434\u043A\u0438 \u043F\u0435\u0440\u0448\u0438\u0445
    \u0456\u043D\u0436\u0435\u043D\u0435\u0440\u0456\u0432 \u043A\u043E\u0440\u043E\u043B\u0456\u0432\u0441\u0442\u0432\u0430,
    \u044F\u043A\u0456 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
    \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E. \u0412\u043E\u043D\u0438
    \u0437\u0431\u043E\u0436\u0435\u0432\u043E\u043B\u0456\u043B\u0438, \u0430\u043B\u0435
    \u0434\u043E\u0441\u0456 \u043F\u0430\u043C'\u044F\u0442\u0430\u044E\u0442\u044C
    \u0441\u0432\u043E\u044E \u0454\u0434\u0438\u043D\u0443 \u043C\u0435\u0442\u0443:
    \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0434\u0435\u0442\u0430\u043B\u0456,
    \u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0437\u043B\u0430\u043C\u0430\u043D\u0435
    \u0456 \u0432\u0431\u0438\u0432\u0430\u0442\u0438 \u0431\u0443\u0434\u044C-\u043A\u043E\u0433\u043E,
    \u0445\u0442\u043E \u0437\u0430\u0432\u0430\u0436\u0430\u0454 \u0440\u043E\u0431\u043E\u0442\u0456
    \u0412\u0435\u043B\u0438\u043A\u043E\u0457 \u041C\u0430\u0448\u0438\u043D\u0438."
