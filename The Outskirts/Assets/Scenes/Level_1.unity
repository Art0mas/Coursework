      m_Calls: []
  m_text: "<b>\"\u0428\u0443\u043A\u0430\u044E \u0432\u0447\u0435\u043D\u043E\u0433\u043E
    \u0430\u0431\u043E \u043C\u0430\u0433\u0430!\"</b>\n\u041F\u043B\u0430\u0447\u0443
    \u0437\u043E\u043B\u043E\u0442\u043E\u043C \u0442\u043E\u043C\u0443, \u0445\u0442\u043E
    \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0441\u0442\u0438
    \"\u0420\u0438\u0442\u0443\u0430\u043B \u0422\u0440\u044C\u043E\u0445\". \u042F
    \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0432\u0456\u0432\u0442\u0430\u0440,
    \u0430\u043B\u0435 \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E, \u043A\u0443\u0434\u0438
    \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0437\u043D\u0430\u0440\u044F\u0434\u0434\u044F. \u0417\u0435\u043C\u043B\u044F,
    \u0421\u0442\u0430\u043B\u044C, \u041D\u0435\u0431\u043E... \u0429\u043E \u0446\u0435
    \u043E\u0437\u043D\u0430\u0447\u0430\u0454? \u0417\u0443\u0441\u0442\u0440\u0456\u0447
    \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0432\u0435\u0447\u0435\u0440\u0456
    \u0431\u0456\u043B\u044F... (\u0434\u0430\u043B\u0456 \u043F\u0430\u043F\u0456\u0440
    \u043E\u0431\u0456\u0440\u0432\u0430\u043D\u043E)"
